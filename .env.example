# Lawyers Agent Backend - Python

## API Keys (copy from root .env or set here)
GOOGLE_API_KEY=

## LangSmith Tracing (optional but recommended)
# Get your key from https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=lawyers-dashboard

    
## Server Settings
HOST=127.0.0.1
PORT=8000

## Search Settings
SEARCH_RESULT_DEFAULT_NUMBER=5
